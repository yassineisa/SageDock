{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SageDock",
  "version": "1.4.5",
  "identifier": "com.sagedock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SageDock",
        "width": 1240,
        "height": 840,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Yassin Eisa",
    "copyright": "Copyright (c) 2026 Yassin Eisa",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": ["msi"],
    "resources": ["runtime/*", "../LICENSE", "../THIRD-PARTY-NOTICES.md"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
